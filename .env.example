# xarchive credentials — copy to data/.env (or the --data-dir)
# and NEVER commit the filled-in file.
#
# Official X API only. Cookie sessions, undocumented GraphQL DeleteTweet,
# and scrapers are not supported.

# --- OAuth 2.0 PKCE user-context (recommended) ---
# Create an app at https://developer.x.com with a confidential or public client.
# Callback URL must be a loopback address, e.g. http://127.0.0.1:8787/callback
# Scopes: tweet.read tweet.write users.read offline.access
#
# Then run:  xarchive auth
# Tokens are stored in <data-dir>/credentials.json (mode 600), not printed.
X_OAUTH2_CLIENT_ID=
# Optional; public PKCE clients can leave this empty.
X_OAUTH2_CLIENT_SECRET=
# Optional override if you already have a user-context access token.
X_OAUTH2_ACCESS_TOKEN=
X_OAUTH2_REFRESH_TOKEN=

# --- OAuth 1.0a user-context (also accepted) ---
# API key/secret + access token/secret from the same developer portal.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional. Default https://api.x.com  (api.twitter.com is equivalent.)
# X_API_BASE=https://api.x.com
